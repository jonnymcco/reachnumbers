// Prisma schema for Reach: The Numbers Puzzle

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  entries LeaderboardEntry[]
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Int
  target        Int
  isDailyPuzzle Boolean  @default(false)
  puzzleDate    String? // YYYY-MM-DD, set only for daily puzzle entries
  timeTaken     Int? // seconds, set only for daily puzzle entries
  createdAt     DateTime @default(now())

  @@unique([userId, puzzleDate], name: "userId_puzzleDate")
  @@index([isDailyPuzzle, puzzleDate])
}
